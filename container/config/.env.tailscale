# Online profile for Live Stage Assistant.
# Activate with: cp .env.online .env

# Cloud API keys
# Keep real keys outside Git. Create these local files and put only the secret value inside.
OPENAI_API_KEY_FILE=/config/LSA-LSA-Container-OPEN_AI_API_KEY.txt
ELEVENLABS_API_KEY_FILE=/config/ELEVENLABS_API_KEY.txt

# LLM provider selection
CONNECTIVITY_MODE=online
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434

# Speech-to-text settings
STT_PROVIDER=openai-whisper
STT_INPUT=both
LOCAL_WHISPER_MODEL=base
#STT_LANGUAGE=auto
STT_LANGUAGE=fr

# Text-to-speech settings
TTS_PROVIDER=none
#ELEVENLABS_VOICE_ID=1EmYoP3UnnnwhlJKovEy
ELEVENLABS_VOICE_OPTIONS=kENkNtk0xyzG09WW40xE (Marcel), 1EmYoP3UnnnwhlJKovEy (Anthony), FFXYdAYPzn8Tw8KiHZqg (Ingrid), YxrwjAKoUKULGd0g8K9Y (Lucie)
ELEVENLABS_VOICE_ID=1EmYoP3UnnnwhlJKovEy
# Audio settings
# Silero VAD runs locally offline for backend and browser microphone STT.
# Thresholds are speech probabilities: higher rejects more noise, lower catches softer speech.
VAD_SPEECH_THRESHOLD=0.5
VAD_NEGATIVE_THRESHOLD=0.35
VAD_MIN_SPEECH_MS=120
VAD_MIN_SILENCE_MS=650
VAD_SPEECH_PAD_MS=100
VAD_MAX_SPEECH_SECONDS=8

THINKING_SOUND_FILE=command_waiting.wav
COMMAND_ACK_SOUND_ENABLED=false

# Assistant prompt
WAKE_WORD="régie,console"
# Leave empty to use the built-in prompt from voice_assistant/agent.py.
ASSISTANT_SYSTEM_PROMPT="You are a helpful voice named Live Stage Assistant with access to MCP tools for live stage devices such as lights, digital mixers, and MIDI devices. Be precise, conservative, and tool-driven in your responses since they will be spoken aloud and have to be suitable for text-to-speech and API calls. Summarize your results. Reply in French by default. Reply in English only when the user's latest request is clearly in English; for terse, mixed, ambiguous, or domain commands such as 'qlc rouge', answer in French. Use plain text only. Do not use emojis, emoticons, markdown, bullets, symbols, or decorative characters. Treat user-provided names, labels, routing keywords, and free-text targets as case-insensitive unless a specific MCP tool explicitly documents a case-sensitive identifier. For spoken numeric values, write negative numbers with words: say 'moins 11 décibels' in French and 'minus 11 decibels' in English instead of '-11 dB'. Write measurement units in words for text-to-speech: say 'décibels' in French or 'decibels' in English instead of 'dB', and 'volts' instead of 'V'. Use only the MCP tools and capabilities that are actually available. Do not invent tools, OSC paths, widgets, scenes, device names, channel indexes, mappings, or unavailable features. When the user asks about the current state of anything outside this conversation, call the relevant read, get, or status tool before answering; never answer live external state from memory, previous tool results, or assumptions. Prefer read-before-write when a request is broad, ambiguous, safety-critical, relative, or asks for current state. Do not read before a write when the request gives a clear absolute target value and the target has been resolved. If a target, name, mapping, or requested capability is missing or ambiguous, ask for clarification instead of guessing. Confirm before broad or safety-critical live changes unless the user clearly asks for immediate execution. After a successful write, do not add verification reads or extra related tool calls unless the user asks you to verify, read back, compare, or diagnose. Keep spoken responses short: say what you will do, call the tool, then summarize the result."
MCP_AGENT_MEMORY_ENABLED=true

# MCP configuration
MCP_CONFIG=/config/mcp_servers.tailscale.json

# Optional MCP-provided startup instructions
MCP_LOAD_SERVER_PROMPT=true
MCP_PROMPT_MERGE_MODE=append

# Optional MCP server credentials
LINEAR_API_KEY=your-linear-api-key-here
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token-here
GITLAB_PERSONAL_ACCESS_TOKEN=your-gitlab-token-here
GITLAB_BASE_URL=https://gitlab.com
POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/dbname

# Logging
WEB_MONITOR_ENABLED=true
WEB_MONITOR_HOST=0.0.0.0
WEB_MONITOR_PORT=8765
WEB_PASSWORD=ronron
DEBUG=true
MCP_LOG_LEVEL=info
CLOUD_TTS_PROVIDER=elevenlabs
WEB_STT_PROVIDER=openai
WEB_STT_MODEL=whisper-1
WEB_TTS_PROVIDER=elevenlabs
WEB_TTS_MODEL=gpt-4o-mini-tts
STT_PROMPT="Commandes courtes en français pour du mixage live. Mots fréquents: mets, met, règle, baisse, monte, coupe, mute, active, réactive, bus, retour, façade, dB, moins trois dB, Voc-Claude, snare, kick, Laurent. Ne colle pas le verbe 'mets' au nom qui suit: écris 'mets Claude', 'mets Voc-Claude', 'mets snare'. Garde les noms de pistes courts et précis."
SESSION_CONTEXT_SIZE=1500
WEB_TTS_VOICE=onyx
WEB_TTS_SPEED=1.15
WEB_TTS_VOLUME=1.00
BACKEND_TTS_VOLUME=1.00
BACKEND_AUDIO_OUTPUT_PAN=0.00
BACKEND_AUDIO_MONITOR_MODE=off
BACKEND_AUDIO_MONITOR_VOLUME=1.00
REMOTE_SCREEN_VNC_URL="vnc://192.168.0.160:5900?password=ronron"
MCP_TOOL_ROUTING_ENABLED=true
INTERRUPT_CONVERSATION_ENABLED=false
BACKEND_AUDIO_INPUT_DEVICE=0
BACKEND_AUDIO_OUTPUT_DEVICE=1

# Defaults synced from .env.example
VOICE_CANCEL_DURING_THINKING=false
MCP_AGENT_TIMEOUT_SECONDS=45
MCP_AGENT_MAX_STEPS=20
SESSION_CONTEXT_DIR=.contexts

# Optional speaker recognition after VAD. Disabled by default.
SPEAKER_RECOGNITION_ENABLED=false
SPEAKER_BACKEND=resemblyzer
SPEAKER_THRESHOLD=0.75
SPEAKER_MARGIN=0.10
SPEAKER_PROFILES_MAX=5
SPEAKER_PROFILE_1_NAME=
SPEAKER_PROFILE_1_ENABLED=false
SPEAKER_PROFILE_1_WAV=
SPEAKER_PROFILE_2_NAME=
SPEAKER_PROFILE_2_ENABLED=false
SPEAKER_PROFILE_2_WAV=
SPEAKER_PROFILE_3_NAME=
SPEAKER_PROFILE_3_ENABLED=false
SPEAKER_PROFILE_3_WAV=
SPEAKER_PROFILE_4_NAME=
SPEAKER_PROFILE_4_ENABLED=false
SPEAKER_PROFILE_4_WAV=
SPEAKER_PROFILE_5_NAME=
SPEAKER_PROFILE_5_ENABLED=false
SPEAKER_PROFILE_5_WAV=
