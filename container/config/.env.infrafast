# Edit this file on the NAS/deployment folder.

# Secrets are read from files mounted in /config.
OPENAI_API_KEY_FILE=/config/LSA-LSA-Container-OPEN_AI_API_KEY.txt
ELEVENLABS_API_KEY_FILE=/config/ELEVENLABS_API_KEY.txt

# Recommended first Docker profile: online LLM/STT, optional ElevenLabs TTS.
CONNECTIVITY_MODE=online
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434

STT_PROVIDER=openai-whisper
LOCAL_WHISPER_MODEL=base
STT_LANGUAGE=fr
STT_PROMPT="⬆️Commandes courtes en français pour commander des dispositif audio visuel sur une scène. Ne colle pas le verbe 'mets' au nom qui suit: écris 'mets Claude', 'mets Voc-Claude', 'mets snare'. "

# CLOUD_TTS_PROVIDER is the TTS dropdown in the web config.
# Options: none | openai | elevenlabs
CLOUD_TTS_PROVIDER=openai
# For DSM/headless Docker, start with none to let browser/web TTS speak.
# Backend cloud TTS can fall back to pyttsx3; browser/web TTS never falls back to pyttsx3.
# The web config "TTS Output" control saves Backend as TTS_PROVIDER=openai|elevenlabs,
# Browser as TTS_PROVIDER=none plus WEB_TTS_PROVIDER=openai|elevenlabs, and Silent as both none.
# pyttsx3/local speaker output requires working /dev/snd passthrough.
TTS_PROVIDER=none
# ElevenLabs voices shown in the web monitor dropdown.
# Format: voice_id (Display name), voice_id2 (Display name 2)
# Browse available voices at https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_OPTIONS=kENkNtk0xyzG09WW40xE (Marcel), 1EmYoP3UnnnwhlJKovEy (Anthony), FFXYdAYPzn8Tw8KiHZqg (Ingrid), YxrwjAKoUKULGd0g8K9Y (Lucie)
ELEVENLABS_VOICE_ID=1EmYoP3UnnnwhlJKovEy

VOICE_SILENCE_THRESHOLD=500
VOICE_SILENCE_DURATION=1.5
THINKING_SOUND_FILE=command_waiting.wav

# Optional global wake word. Empty disables wake-word gating.
# Multiple variants can be separated by comma, semicolon, or pipe.
WAKE_WORD=mixeur,mixer
ASSISTANT_SYSTEM_PROMPT="You are a helpful voice named Live Stage Assistant with access to MCP tools for live stage devices such as lights, digital mixers, and MIDI devices. Be precise, conservative, and tool-driven in your responses since they will be spoken aloud and have to be suitable for text-to-speech and API calls. Summarize your results. Reply in the same language as the user's latest request whenever possible. Use plain text only. Do not use emojis, emoticons, markdown, bullets, symbols, or decorative characters. For spoken numeric values, write negative numbers with words: say 'moins 11 décibels' in French and 'minus 11 decibels' in English instead of '-11 dB'. Write measurement units in words for text-to-speech: say 'décibels' in French or 'decibels' in English instead of 'dB', and 'volts' instead of 'V'. Use only the MCP tools and capabilities that are actually available. Do not invent tools, OSC paths, widgets, scenes, device names, channel indexes, mappings, or unavailable features. When the user asks about the current state of anything outside this conversation, call the relevant read, get, or status tool before answering; never answer live external state from memory, previous tool results, or assumptions. Prefer read-before-write when a request is broad, ambiguous, safety-critical, relative, or asks for current state. Do not read before a write when the request gives a clear absolute target value and the target has been resolved. If a target, name, mapping, or requested capability is missing or ambiguous, ask for clarification instead of guessing. Confirm before broad or safety-critical live changes unless the user clearly asks for immediate execution. After a successful write, do not add verification reads or extra related tool calls unless the user asks you to verify, read back, compare, or diagnose. Keep spoken responses short: say what you will do, call the tool, then summarize the result."

MCP_AGENT_MEMORY_ENABLED=true
# Maximum time, in seconds, to wait for one LLM/MCP response before returning a timeout message.
MCP_AGENT_TIMEOUT_SECONDS=45
# Maximum active session summary characters injected into one LLM/MCP turn. 0 disables context injection.
# In the web chat, green bubbles show which restored messages fit in this current context window.
SESSION_CONTEXT_SIZE=6000
# Directory where session .context files are stored. Keep it outside source control for private conversations.
SESSION_CONTEXT_DIR=/data/contexts

MCP_CONFIG=/config/mcp_servers.infrafast.json
MCP_LOAD_SERVER_PROMPT=true
MCP_PROMPT_MERGE_MODE=append

LINEAR_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_BASE_URL=https://gitlab.com
POSTGRES_CONNECTION_STRING=

# Bind to all interfaces in a container so DSM/LAN can reach the monitor.
WEB_MONITOR_ENABLED=true
WEB_MONITOR_HOST=0.0.0.0
WEB_MONITOR_PORT=8765
# Optional browser-side audio controls proxied through the backend.
# WEB_TTS_PROVIDER controls browser playback only. The web config keeps it equal to CLOUD_TTS_PROVIDER.
# Options: openai | elevenlabs | none.
# Backend TTS has priority: when TTS_PROVIDER is not "none", web TTS is disabled to avoid double audio.
WEB_AUDIO_ENABLED=true
WEB_STT_PROVIDER=openai
WEB_STT_MODEL=whisper-1
WEB_TTS_PROVIDER=openai
WEB_TTS_MODEL=gpt-4o-mini-tts
WEB_CONVERSATION_THRESHOLD=0.035
WEB_CONVERSATION_SILENCE_MS=900
WEB_RECORDING_MAX_SECONDS=8
WEB_TTS_VOICE=alloy
# Cloud TTS speed. Browser TTS uses browser playback speed; backend cloud TTS passes it to the provider.
WEB_TTS_SPEED=1.55
REMOTE_SCREEN_VNC_URL="vnc://192.168.0.160:5900?password=ronron"

MCP_LOG_LEVEL=info
