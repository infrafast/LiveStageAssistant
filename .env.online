# Online profile for Live Stage Assistant.
# Activate with: cp .env.online .env

# Cloud API keys
# Keep real keys outside Git. Create these local files and put only the secret value inside.
OPENAI_API_KEY_FILE=LSA-LSA-Localhost-OPENAI_API_KEY.txt
ELEVENLABS_API_KEY_FILE=ELEVENLABS_API_KEY.txt

# LLM provider selection
CONNECTIVITY_MODE=online
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434

# Backend speech-to-text settings for the physical/local microphone.
# STT_PROVIDER: openai-whisper uses the OpenAI Whisper API; local-whisper uses LOCAL_WHISPER_MODEL.
# STT_LANGUAGE: use fr/en/etc. for stronger recognition, or auto for automatic language detection.
# STT_PROMPT biases Whisper toward short stage-control commands and track names.
STT_PROVIDER=openai-whisper
LOCAL_WHISPER_MODEL=base
#STT_LANGUAGE=auto
STT_LANGUAGE=fr
STT_PROMPT="⬆️Commandes courtes en français pour commander des dispositif audio visuel sur une scène. Ne colle pas le verbe 'mets' au nom qui suit: écris 'mets Claude', 'mets Voc-Claude', 'mets snare'. "

# Text-to-speech settings
# CLOUD_TTS_PROVIDER is the TTS dropdown in the web config.
# Options: none | openai | elevenlabs
CLOUD_TTS_PROVIDER=elevenlabs
# TTS_PROVIDER controls backend/non-web speech.
# Backend cloud TTS can fall back to pyttsx3; browser/web TTS never falls back to pyttsx3.
# The web config "TTS Output" control saves Backend as TTS_PROVIDER=openai|elevenlabs,
# Browser as TTS_PROVIDER=none plus WEB_TTS_PROVIDER=openai|elevenlabs, and Silent as both none.
TTS_PROVIDER=none
#ELEVENLABS_VOICE_ID=1EmYoP3UnnnwhlJKovEy
ELEVENLABS_VOICE_OPTIONS=kENkNtk0xyzG09WW40xE (Marcel), 1EmYoP3UnnnwhlJKovEy (Anthony), FFXYdAYPzn8Tw8KiHZqg (Ingrid), YxrwjAKoUKULGd0g8K9Y (Lucie)
ELEVENLABS_VOICE_ID=1EmYoP3UnnnwhlJKovEy

# Backend microphone voice activity detection before STT.
# VOICE_SILENCE_THRESHOLD: lower is more sensitive; raise it if breaths/noise trigger recording.
# VOICE_SILENCE_DURATION: seconds of silence after accepted speech before recording stops.
# VOICE_MIN_SPEECH_MS / FRAMES: minimum non-silent input required before backend STT runs.
# THINKING_SOUND_FILE: WAV loop while the assistant processes a command.
VOICE_SILENCE_THRESHOLD=500
VOICE_SILENCE_DURATION=1.5
VOICE_MIN_SPEECH_MS=350
VOICE_MIN_SPEECH_FRAMES=5
THINKING_SOUND_FILE=chatgpt.wav

# Assistant prompt
# Optional global wake word. Empty disables wake-word gating.
# Multiple variants can be separated by comma, semicolon, or pipe.
WAKE_WORD="régie,console"
# Leave empty to use the built-in prompt from voice_assistant/agent.py.
ASSISTANT_SYSTEM_PROMPT="You are a helpful voice assistant named is Live Stage Assistant with access to various tools. Be precise, conservative, and tool-driven in your responses since they will be spoken aloud and have to be suitable for text-to-speech and API calls. Don't be verbose but summarize your results. Reply in the same language as the user's latest request whenever possible. Use plain text only. Do not use emojis, emoticons, markdown, bullets, symbols, or decorative characters. Behave like a friendly calm and motivating assistant. Use conversation memory for context, preferences, and follow-up references, but not as the source of truth for live external state. When the user asks about the current state of anything outside this conversation, treat the answer as time-sensitive. Use the relevant MCP read tool before answering. Do not answer current external state from memory, previous tool results, or assumptions. If no suitable read tool is available, say that you cannot verify the current state and use only tools exposed by the MCP servers."

MCP_AGENT_MEMORY_ENABLED=true
# Maximum time, in seconds, to wait for one LLM/MCP response before returning a timeout message.
MCP_AGENT_TIMEOUT_SECONDS=45
# Maximum active session summary characters injected into one LLM/MCP turn. 0 disables context injection.
# In the web chat, green bubbles show which restored messages fit in this current context window.
SESSION_CONTEXT_SIZE=6000
# Directory where session .context files are stored. Keep it outside source control for private conversations.
SESSION_CONTEXT_DIR=.contexts

# MCP configuration
MCP_CONFIG=mcp_servers.json

# Optional MCP-provided startup instructions
MCP_LOAD_SERVER_PROMPT=true
MCP_PROMPT_MERGE_MODE=append
MCP_TOOL_ROUTING_ENABLED=true

# Optional MCP server credentials
LINEAR_API_KEY=your-linear-api-key-here
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token-here
GITLAB_PERSONAL_ACCESS_TOKEN=your-gitlab-token-here
GITLAB_BASE_URL=https://gitlab.com
POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/dbname

# Logging
WEB_MONITOR_ENABLED=true
WEB_MONITOR_HOST=127.0.0.1
WEB_MONITOR_PORT=8765
DEBUG=true
MCP_LOG_LEVEL=info
WEB_AUDIO_ENABLED=true
# Browser STT provider/model used by the web microphone endpoint.
WEB_STT_PROVIDER=openai
WEB_STT_MODEL=whisper-1
# Browser microphone limits and conversation-mode voice activity detection.
# WEB_RECORDING_MAX_SECONDS: hard cap for one browser recording.
# WEB_CONVERSATION_SILENCE_MS: silence after accepted speech before sending the segment to STT.
# WEB_CONVERSATION_IDLE_SECONDS: restart listener when no speech is detected.
# WEB_CONVERSATION_THRESHOLD: browser RMS level required to count as speech.
# WEB_CONVERSATION_MIN_SPEECH_MS / FRAMES: minimum above-threshold input before STT runs.
WEB_RECORDING_MAX_SECONDS=8
WEB_CONVERSATION_SILENCE_MS=1200
WEB_CONVERSATION_IDLE_SECONDS=25
WEB_CONVERSATION_THRESHOLD=0.05
WEB_CONVERSATION_MIN_SPEECH_MS=350
WEB_CONVERSATION_MIN_SPEECH_FRAMES=8
WEB_TTS_PROVIDER=elevenlabs
WEB_TTS_MODEL=gpt-4o-mini-tts
WEB_TTS_VOICE=alloy
WEB_TTS_SPEED=1.15
REMOTE_SCREEN_VNC_URL="vnc://192.168.0.160:5900?password=ronron"
