{
  "mcpServers": {
    "mixer": {
      "command": "node",
      "args": [
        "../XMSeries-MCP/dist/index.js"
      ],
      "env": {
        "OSC_HOST": "192.168.0.1",
        "OSC_PORT": "10023",
        "OSC_PROTOCOL": "OSCX32M32",
        "MCP_PROMPT_FILE": "../XMSeries-MCP/PROMPT.md",
        "DEBUG": "${DEBUG}"
      },
      "assistantOptions": {
        "routing": "mixer,mix,mixage,volume,façade,moniteur,retour,bus,db,tranche"
      }
    },
    "qlcplus": {
      "command": "node",
      "args": [
        "../QLCPlus-MCP/dist/src/index.js"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "DOTENV_CONFIG_QUIET": "true",
        "QLC_HOST": "127.0.0.1",
        "QLC_OSC_INPUT_PORT": "7700",
        "QLC_OSC_OUTPUT_PORT": "9000",
        "QLC_UNIVERSE": "1",
        "QLC_WIDGETS_FILE": "../QLCPlus-MCP/config/widgets.json",
        "QLC_ALLOW_RAW_OSC": "false",
        "QLC_DRY_RUN": "false",
        "MCP_PROMPT_FILE": "../QLCPlus-MCP/PROMPT.md",
        "LOG_LEVEL": "info",
        "NODE_ENV": "production"
      },
      "assistantOptions": {
        "routing": "qlc,qlcplus,lumière,light,éclairage,scène,dmx,fixture,projecteur,couleur"
      }
    }
  }
}
