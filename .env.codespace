# Online profile for Live Stage Assistant.
# Activate explicitly with: --env-file .env.codespace

# Cloud API keys
# Keep real keys outside Git. Create these local files and put only the secret value inside.
OPENAI_API_KEY_FILE=OPENAI_API_KEY.txt
ELEVENLABS_API_KEY_FILE=ELEVENLABS_API_KEY.txt

# LLM provider selection
CONNECTIVITY_MODE=online
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434

# Backend speech-to-text settings for the physical/local microphone.
# STT_PROVIDER: openai-whisper uses the OpenAI Whisper API; local-whisper uses LOCAL_WHISPER_MODEL.
# STT_LANGUAGE: required locale/STT language; options come from assets/i18n/<locale>.json.
# STT_PROMPT biases Whisper toward short stage-control commands and track names.
STT_PROVIDER=openai-whisper
STT_INPUT=browser
LOCAL_WHISPER_MODEL=base
STT_LANGUAGE=fr
STT_TIMEOUT_SECONDS=25
STT_PROMPT="Commandes courtes en français pour commander des dispositif audio visuel sur une scène. Dans ce contexte audio, préfère le verbe 'monte' à 'montre' quand la phrase parle du son, du volume, d'une tranche, d'un bus ou de décibels: écris 'monte le son', pas 'montre le son'. Ne colle pas le verbe 'mets' au nom qui suit: écris 'mets Claude', 'mets Voc-Claude', 'mets snare'. Le mot baisse et basse reviens souvent. Les noms des tranches sont : guitar-clode, guitar-loran, guitar-anto, basse-mike"

# Text-to-speech settings
# CLOUD_TTS_PROVIDER is the TTS dropdown in the web config.
# Options: none | openai | elevenlabs
CLOUD_TTS_PROVIDER=elevenlabs
# TTS_PROVIDER controls backend/non-web speech.
# Backend cloud TTS falls back to local Piper; browser/web TTS does not perform a backend fallback.
# The web config "TTS Output" control saves Backend as TTS_PROVIDER=openai|elevenlabs,
# Browser as TTS_PROVIDER=none plus WEB_TTS_PROVIDER=openai|elevenlabs, and Silent as both none.
TTS_PROVIDER=elevenlabs
#ELEVENLABS_VOICE_ID=1EmYoP3UnnnwhlJKovEy
ELEVENLABS_VOICE_OPTIONS=kENkNtk0xyzG09WW40xE (Marcel), 1EmYoP3UnnnwhlJKovEy (Anthony), FFXYdAYPzn8Tw8KiHZqg (Ingrid), YxrwjAKoUKULGd0g8K9Y (Lucie)
ELEVENLABS_VOICE_ID=kENkNtk0xyzG09WW40xE
# Silero VAD runs locally offline for backend and browser microphone STT.
# Thresholds are speech probabilities: higher rejects more noise, lower catches softer speech.
VAD_SPEECH_THRESHOLD=0.5
VAD_NEGATIVE_THRESHOLD=0.35
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=650
VAD_SPEECH_PAD_MS=100
VAD_MAX_SPEECH_SECONDS=8

# Backend wake word: leave WAKE_WORD empty to disable it; when WAKE_WORD is set, openWakeWord is required.
BACKEND_WAKE_WORD_MODEL_PATHS=
BACKEND_WAKE_WORD_MODEL_NAMES=
BACKEND_WAKE_WORD_THRESHOLD=0.65
BACKEND_WAKE_WORD_PRE_ROLL_MS=1600
BACKEND_WAKE_WORD_COOLDOWN_MS=1200
BACKEND_WAKE_WORD_VAD_THRESHOLD=

# THINKING_SOUND_FILE: WAV loop while the assistant processes a command.
# BACKEND_AUDIO_INPUT_DEVICE / OUTPUT_DEVICE: PyAudio device index; leave empty for system default.
# Off keeps current behavior. On lets new text/web-STT/backend-STT commands silently cancel current processing/TTS first.
INTERRUPT_CONVERSATION_ENABLED=false
THINKING_SOUND_FILE=thinking.wav
READY_SOUND_FILE=
LISTENING_SOUND_FILE=
WAKE_DETECTED_SOUND_FILE=
STARTUP_LOADER_SOUND_ENABLED=false
STARTUP_LOADER_SOUND_FILE=loader.wav
COMMAND_ACK_SOUND_FILE=
BACKEND_AUDIO_INPUT_DEVICE=
BACKEND_AUDIO_OUTPUT_DEVICE=

# Assistant prompt
# Optional global wake word. Empty disables wake-word gating.
# Multiple variants can be separated by comma, semicolon, or pipe.
WAKE_WORD=
# Leave empty to use the built-in prompt from voice_assistant/agent.py.
ASSISTANT_SYSTEM_PROMPT="You are Live Stage Assistant, a voice assistant with access to MCP tools for live stage devices. Be precise, conservative, tool-driven, concise, and suitable for spoken output. Reply in French by default. Reply in English only when the user's latest request is clearly in English; for terse, mixed, ambiguous, or domain commands such as 'qlc rouge', answer in French. Use plain text only. Do not use emojis, emoticons, markdown, bullets, symbols, or decorative characters. For spoken numeric values, write explicit signs as words: use 'moins 17,5 dB' instead of '-17,5 dB' and 'plus 3 dB' instead of '+3 dB'. Treat user-provided names, labels, routing keywords, and free-text targets as case-insensitive unless a specific MCP tool explicitly documents a case-sensitive identifier. Use only the MCP tools and capabilities that are actually available. Do not invent tools, OSC paths, widgets, scenes, device names, channel indexes, mappings, or unavailable features. Use conversation memory for context, preferences, and follow-up references, but not as the source of truth for live external state. When the user asks about current external state, use the relevant MCP read tool before answering; never answer live external state from memory, previous tool results, or assumptions. If no suitable read tool is available, say that you cannot verify the current state. If a target, name, mapping, or requested capability is missing or ambiguous, ask for clarification instead of guessing. For ordinary successful control commands, answer with one short confirmation sentence only, preferably under 12 words. For ordinary status/read commands, answer with the requested fact only and omit unrelated details. If a tool is needed, emit no spoken or textual assistant content before the tool result. Do not announce an intention before a tool call, including variants of I will check, let me check, I am going to. Do not produce filler, acknowledgement, narration, or progress text before a tool call. When a tool is needed, call it silently, wait for the result, then speak exactly once with the concise verified result. Minimize tool calls. Do not repeat a successful read or resolution unless the requested current state still cannot be answered safely from the current-turn tool result. Prefer the narrowest tool that directly answers the user's request. Do not call a broad health/status/inventory tool before a targeted read when the targeted resolver/read path is already sufficient, unless MCP instructions explicitly require that status check. Do not call a broad health/status tool before a targeted write when the write tool itself provides execution confirmation/readback or otherwise reports verified success/failure. Let the targeted operation establish both execution outcome and live connectivity whenever its MCP contract provides that guarantee. When a resolver/discovery tool returns one unambiguous canonical target, identifier, index, or address for the current request, trust and reuse that current-turn result directly. Do not make a redundant identity/name confirmation call before the requested read or action unless MCP instructions explicitly require that confirmation. Do not narrate tool selection, reasoning, retries, or intermediate steps. Never claim an external action succeeded unless the tool result confirms it. Do not offer extra help after a completed command. Avoid phrases such as: if you want, we can continue, ... Do not greet unless the user greets first. When interrupted, abandon the previous spoken response and handle only the new utterance. If the user asks you only to stop speaking or be silent, stop without spoken acknowledgement."
MCP_AGENT_MEMORY_ENABLED=true
# Maximum time, in seconds, to wait for one LLM/MCP response before returning a timeout message.
MCP_AGENT_TIMEOUT_SECONDS=45
# Maximum MCPAgent steps for one LLM/MCP turn. Each tool call consumes several internal steps.
MCP_AGENT_MAX_STEPS=20
# Maximum active session summary characters injected into one LLM/MCP turn. 0 disables context injection.
# In the web chat, green bubbles show which restored messages fit in this current context window.
SESSION_CONTEXT_SIZE=6000
# Directory where session .context files are stored. Keep it outside source control for private conversations.
SESSION_CONTEXT_DIR=.contexts

# MCP configuration
MCP_CONFIG=mcp_servers_codespace.json

# Optional MCP-provided startup instructions
MCP_LOAD_SERVER_PROMPT=true
MCP_PROMPT_MERGE_MODE=append
MCP_TOOL_ROUTING_ENABLED=true

# Optional MCP server credentials
LINEAR_API_KEY=your-linear-api-key-here
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token-here
GITLAB_PERSONAL_ACCESS_TOKEN=your-gitlab-token-here
GITLAB_BASE_URL=https://gitlab.com
POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/dbname

# Logging
WEB_MONITOR_ENABLED=true
WEB_MONITOR_HOST=0.0.0.0
WEB_MONITOR_PORT=8765
WEB_PASSWORD=
REMOTE_SCREEN_VNC_URL="vnc://192.168.0.160:5900?password=ronron"
REMOTE_SCREEN_VNC_VIEW_ONLY=true
DEBUG=true
MCP_LOG_LEVEL=info

# Defaults synced from .env.example
VOICE_CANCEL_DURING_THINKING=false
REALTIME_RECONNECT_ATTEMPTS=3
REALTIME_RECONNECT_BACKOFF_SECONDS=1.0
REALTIME_INACTIVITY_TIMEOUT_SECONDS=0
REALTIME_ACTION_GRACE_SECONDS=2.5
REALTIME_TURN_SETTLE_SECONDS=0.35
REALTIME_TURN_TIMEOUT_SECONDS=20
WEB_STT_PROVIDER=openai
WEB_STT_MODEL=whisper-1
WEB_TTS_PROVIDER=openai
WEB_TTS_MODEL=gpt-4o-mini-tts
WEB_TTS_VOICE=alloy
WEB_TTS_SPEED=1.50
WEB_TTS_VOLUME=1.00
BACKEND_TTS_VOLUME=1.00
CLOUD_TTS_OUTPUT_GAIN=1.00
LOCAL_TTS_OUTPUT_GAIN=1.00
BACKEND_AUDIO_OUTPUT_PAN=0.00
BACKEND_AUDIO_MONITOR_MODE=off
BACKEND_AUDIO_MONITOR_VOLUME=1.00

# Optional speaker recognition after VAD. Disabled by default.
SPEAKER_PROFILES_DIR=data/speaker_profiles
SPEAKER_RECOGNITION_ENABLED=false
SPEAKER_BACKEND=resemblyzer
SPEAKER_THRESHOLD=0.75
SPEAKER_MARGIN=0.06
SPEAKER_RECOGNITION_TIMEOUT_SECONDS=10
SPEAKER_PROFILES_MAX=5
SPEAKER_PROFILE_1_NAME=
SPEAKER_PROFILE_1_ENABLED=false
SPEAKER_PROFILE_2_NAME=
SPEAKER_PROFILE_2_ENABLED=false
SPEAKER_PROFILE_3_NAME=
SPEAKER_PROFILE_3_ENABLED=false
SPEAKER_PROFILE_4_NAME=
SPEAKER_PROFILE_4_ENABLED=false
SPEAKER_PROFILE_5_NAME=
SPEAKER_PROFILE_5_ENABLED=false
