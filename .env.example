# Required API Keys
# OpenAI API key for Whisper (speech-to-text) and GPT models
# Put the real key in this ignored local text file.
OPENAI_API_KEY_FILE=OPENAI_API_KEY.txt

# Optional but Recommended
# ElevenLabs API key for high-quality text-to-speech
# Without this, the assistant will use the system TTS (pyttsx3)
ELEVENLABS_API_KEY_FILE=ELEVENLABS_API_KEY.txt

# Optional - Model Settings
CONNECTIVITY_MODE=online
# OpenAI model for the assistant (default: gpt-4)
# Options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4

# Optional - backend speech-to-text settings for the physical/local microphone.
# STT_PROVIDER: openai-whisper uses the OpenAI Whisper API; local-whisper uses LOCAL_WHISPER_MODEL.
# STT_LANGUAGE: use fr/en/etc. for stronger recognition, or auto for automatic language detection.
# STT_PROMPT biases Whisper toward short stage-control commands and track names.
STT_PROVIDER=openai-whisper
# STT_INPUT controls which microphone sources can create commands: both | backend | browser | silent.
STT_INPUT=both
LOCAL_WHISPER_MODEL=base
STT_LANGUAGE=auto
# At runtime, assistantOptions.routing keywords from MCP_CONFIG are appended to this STT prompt without rewriting this file.
STT_PROMPT="Commandes courtes en français pour commander des dispositif audio visuel sur une scène. Dans ce contexte audio, préfère le verbe 'monte' à 'montre' quand la phrase parle du son, du volume, d'une tranche, d'un bus ou de décibels: écris 'monte le son', pas 'montre le son'. Ne colle pas le verbe 'mets' au nom qui suit: écris 'mets Claude', 'mets Voc-Claude', 'mets snare'. "

# Optional - Voice / TTS Settings
# CLOUD_TTS_PROVIDER is the TTS dropdown in the web config.
# Options: none | openai | elevenlabs
# - none disables cloud TTS for both browser playback and backend cloud playback.
# - openai / elevenlabs select the cloud provider used by browser TTS and backend cloud TTS.
CLOUD_TTS_PROVIDER=openai

# TTS_PROVIDER controls where non-web/backend speech is played.
# Options:
# - openai or elevenlabs: backend speaker uses the selected cloud TTS and falls back to pyttsx3 if cloud playback fails.
# - pyttsx3: backend speaker uses local system TTS only.
# - none: backend speaker is silent; this is required when you want browser/web TTS to speak.
# The web config "TTS Output" control saves Backend as TTS_PROVIDER=openai|elevenlabs,
# Browser as TTS_PROVIDER=none plus WEB_TTS_PROVIDER=openai|elevenlabs, and Silent as both none.
TTS_PROVIDER=none

# ElevenLabs voices shown in the web monitor dropdown.
# Format: voice_id (Display name), voice_id2 (Display name 2)
# Browse available voices at https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_OPTIONS=kENkNtk0xyzG09WW40xE (Marcel), 1EmYoP3UnnnwhlJKovEy (Anthony), FFXYdAYPzn8Tw8KiHZqg (Ingrid), YxrwjAKoUKULGd0g8K9Y (Lucie)
ELEVENLABS_VOICE_ID=ZF6FPAbjXT4488VcRRnw
# Silero VAD runs locally offline for backend and browser microphone STT.
# Thresholds are speech probabilities: higher rejects more noise, lower catches softer speech.
VAD_SPEECH_THRESHOLD=0.5
VAD_NEGATIVE_THRESHOLD=0.35
VAD_MIN_SPEECH_MS=120
VAD_MIN_SILENCE_MS=650
VAD_SPEECH_PAD_MS=100
VAD_MAX_SPEECH_SECONDS=8

# Off keeps current behavior. On lets new text/web-STT/backend-STT commands silently cancel current processing/TTS first.
INTERRUPT_CONVERSATION_ENABLED=false

# Optional backend audio device selection.
# Values are PyAudio device indexes exposed in Settings -> Config -> Audio In/Out.
# Leave empty, or select an unavailable device, to fall back to the system default.
BACKEND_AUDIO_INPUT_DEVICE=
BACKEND_AUDIO_OUTPUT_DEVICE=

# Optional experimental voice cancel while the assistant is thinking.
# When false, no extra microphone listener is started and behavior stays unchanged.
# When true, saying "stop", "annule", "annuler", "arrête", or "cancel" during thinking cancels the active request.
VOICE_CANCEL_DURING_THINKING=false

# WAV loop played while the LLM/MCP agent is processing a command.
# Bare filenames are resolved from assets/.
# Leave empty to disable the thinking sound.
THINKING_SOUND_FILE=thinking.wav

# Optional - Assistant Configuration
# Optional global wake word. Empty keeps the current behavior; when set, only matching transcriptions are processed.
# Multiple variants can be separated by comma, semicolon, or pipe.
WAKE_WORD="régie,console"

# System prompt for the AI assistant
# Customize the assistant's personality and behavior
ASSISTANT_SYSTEM_PROMPT="You are a helpful voice assistant named is Live Stage Assistant with access to various tools. Be precise, conservative, and tool-driven in your responses since they will be spoken aloud and have to be suitable for text-to-speech and API calls. Don't be verbose but summarize your results. Reply in French by default. Reply in English only when the user's latest request is clearly in English; for terse, mixed, ambiguous, or domain commands such as 'qlc rouge', answer in French. Use plain text only. Do not use emojis, emoticons, markdown, bullets, symbols, or decorative characters. Treat user-provided names, labels, routing keywords, and free-text targets as case-insensitive unless a specific MCP tool explicitly documents a case-sensitive identifier. Behave like a friendly calm and motivating assistant. Use conversation memory for context, preferences, and follow-up references, but not as the source of truth for live external state. When the user asks about the current state of anything outside this conversation, treat the answer as time-sensitive. Use the relevant MCP read tool before answering. Do not answer current external state from memory, previous tool results, or assumptions. If no suitable read tool is available, say that you cannot verify the current state and use only tools exposed by the MCP servers."
# Keep conversation memory enabled for context, but never use it as source of truth for live external state.
MCP_AGENT_MEMORY_ENABLED=true
# Maximum time, in seconds, to wait for one LLM/MCP response before returning a timeout message.
MCP_AGENT_TIMEOUT_SECONDS=45
# Maximum MCPAgent steps for one LLM/MCP turn. Each tool call consumes several internal steps.
MCP_AGENT_MAX_STEPS=20
# When true, assistantOptions.routing keywords in MCP_CONFIG can restrict one turn to one MCP server's tools.
MCP_TOOL_ROUTING_ENABLED=true
# Maximum active session summary characters injected into one LLM/MCP turn. 0 disables context injection.
# In the web chat, green bubbles show which restored messages fit in this current context window.
SESSION_CONTEXT_SIZE=6000
# Directory where session .context files are stored. Keep it outside source control for private conversations.
SESSION_CONTEXT_DIR=.contexts

# Optional - MCP-provided Assistant Instructions
# When enabled, the assistant loads startup instructions from assistantPrompt blocks in MCP_CONFIG.
MCP_LOAD_SERVER_PROMPT=false
# append keeps the local assistant prompt before the loaded MCP prompts; replace uses only the loaded MCP prompts.
MCP_PROMPT_MERGE_MODE=append

# Linear API key for task management integration
# The Linear MCP server can also use browser-based authentication
LINEAR_API_KEY=your-linear-api-key-here

# GitHub personal access token for GitHub MCP server
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token-here

# GitLab configuration for GitLab MCP server
GITLAB_PERSONAL_ACCESS_TOKEN=your-gitlab-token-here
GITLAB_BASE_URL=https://gitlab.com

# PostgreSQL connection string for database MCP server
POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/dbname

# Optional - Development Settings
# Local web monitor for chat commands, state, active config, console logs, and final prompt.
WEB_MONITOR_ENABLED=true
WEB_MONITOR_HOST=0.0.0.0
WEB_MONITOR_PORT=8765

# Optional browser-side audio controls proxied through the backend.
# Browser audio is enabled automatically when STT_INPUT includes browser
# or when WEB_TTS_PROVIDER selects a cloud provider.
# WEB_TTS_PROVIDER controls browser playback only. It is kept equal to CLOUD_TTS_PROVIDER
# by the web config when browser TTS should use the selected cloud provider.
# Options: openai | elevenlabs | none
# No pyttsx3 fallback is used for browser/web TTS.
# Backend TTS has priority: when TTS_PROVIDER is not "none", web TTS is disabled to avoid double audio.
# Browser STT provider/model used by the web microphone endpoint.
WEB_STT_PROVIDER=openai
WEB_STT_MODEL=whisper-1
WEB_TTS_PROVIDER=openai
WEB_TTS_MODEL=gpt-4o-mini-tts
WEB_TTS_VOICE=alloy
# Cloud TTS speed. Browser TTS uses browser playback speed; backend cloud TTS passes it to the provider.
WEB_TTS_SPEED=1.50
WEB_TTS_VOLUME=1.00
BACKEND_TTS_VOLUME=1.00
BACKEND_AUDIO_OUTPUT_PAN=0.00
REMOTE_SCREEN_VNC_URL="vnc://192.168.0.160:5900?password=ronron"

# Enable debug logging
DEBUG=false

# MCP server log level (debug, info, warn, error)
MCP_LOG_LEVEL=info
