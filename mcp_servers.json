{
  "mcpServers": {
    "mixer": {
      "command": "node",
      "args": [
        "../XMSeries-MCP/dist/index.js"
      ],
      "env": {
        "OSC_HOST": "192.168.0.1",
        "OSC_PORT": "10023",
        "OSC_PROTOCOL": "OSCX32M32",
        "MCP_PROMPT_FILE": "../XMSeries-MCP/PROMPT.md",
        "DEBUG": "${DEBUG}",
        "XMS_SPEAKER_MAP": "{\"laurent\":{\"bus\":\"Laurent\",\"channel\":\"Guitar-loran\"},\"thomas\":{\"bus\":\"Laurent\",\"channel\":\"Guitar-loran\"}}"
      },
      "assistantOptions": {
        "routing": "mixer,mix,mixage,volume,façade,moniteur,retour,bus,db,tranche"
      }
    },
    "qlcplus": {
      "command": "node",
      "args": [
        "../QLCPlus-MCP/dist/src/index.js"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "QLC_NATIVE_HOST": "192.168.0.160",
        "QLC_NATIVE_PORT": "9998",
        "QLC_NATIVE_CLIENT_NAME": "QLCPlus-MCP",
        "QLC_DRY_RUN": "false",
        "LOG_LEVEL": "info",
        "NODE_ENV": "production"
      },
      "assistantOptions": {
        "routing": "qlc,qlcplus,lumière,light,éclairage,scène,dmx,fixture,projecteur,couleur"
      }
    }
  }
}
