{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "--offline",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "env": {}
    },
    "memory": {
      "command": "npx",
      "args": [
        "--offline",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {}
    },
    "mixer": {
      "command": "node",
      "args": [
        "../XMSeries-MCP/dist/index.js"
      ],
      "env": {
        "OSC_HOST": "192.168.0.1",
        "OSC_PORT": "10023",
        "OSC_PROTOCOL": "OSCXR",
        "OSC_CHANNEL_COUNT": "16",
        "OSC_BUS_COUNT": "4",
        "OSC_FX_COUNT": "4",
        "OSC_DCA_COUNT": "4",
        "DEBUG": "${DEBUG}",
        "MCP_PROMPT_FILE": "../XMSeries-MCP/PROMPT.md"
      },
      "assistantOptions": {
        "routing": "mixer,mix,mixage,volume,façade,moniteur,retour,bus,db,tranche"
      }
    }
  }
}
