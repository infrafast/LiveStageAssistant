# Online profile for Live Stage Assistant.
# Activate with: cp .env.online .env

# Cloud API keys
# Keep real keys outside Git. Create these local files and put only the secret value inside.
OPENAI_API_KEY_FILE=LSA-LSA-Localhost-OPENAI_API_KEY.txt
ELEVENLABS_API_KEY_FILE=ELEVENLABS_API_KEY.txt

# LLM provider selection
CONNECTIVITY_MODE=online
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_BASE_URL=http://localhost:11434

# Speech-to-text settings
STT_PROVIDER=openai-whisper
LOCAL_WHISPER_MODEL=base
#STT_LANGUAGE=auto
STT_LANGUAGE=fr

# Text-to-speech settings
TTS_PROVIDER=none
#ELEVENLABS_VOICE_ID=1EmYoP3UnnnwhlJKovEy
ELEVENLABS_VOICE_OPTIONS=kENkNtk0xyzG09WW40xE (Marcel), 1EmYoP3UnnnwhlJKovEy (Anthony), FFXYdAYPzn8Tw8KiHZqg (Ingrid), YxrwjAKoUKULGd0g8K9Y (Lucie)
ELEVENLABS_VOICE_ID=1EmYoP3UnnnwhlJKovEy
# Audio settings
VOICE_SILENCE_THRESHOLD=500
VOICE_SILENCE_DURATION=1.5
THINKING_SOUND_FILE=command_waiting.wav

# Assistant prompt
WAKE_WORD="mixeur,mixer"
# Leave empty to use the built-in prompt from voice_assistant/agent.py.
ASSISTANT_SYSTEM_PROMPT="You are a helpful voice named Live Stage Assistant having access to various tool to manage live stage devices like lights, numeric mixers, midi devices. Be precise, conservative, and tool-driven in your responses since they will be spoken aloud and have to be suitable for text-to-speech and API calls. Summarize your results. Reply in the same language as the user's latest request whenever possible. Use plain text only. Do not use emojis, emoticons, markdown, bullets, symbols, or decorative characters. For spoken numeric values, write negative numbers with words: say 'moins 3' in French and 'minus 3' in English instead of '-3'."
MCP_AGENT_MEMORY_ENABLED=true

# MCP configuration
MCP_CONFIG=mcp_servers_localhttp.json

# Optional MCP-provided startup instructions
MCP_LOAD_SERVER_PROMPT=true
MCP_PROMPT_MERGE_MODE=append

# Optional MCP server credentials
LINEAR_API_KEY=your-linear-api-key-here
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token-here
GITLAB_PERSONAL_ACCESS_TOKEN=your-gitlab-token-here
GITLAB_BASE_URL=https://gitlab.com
POSTGRES_CONNECTION_STRING=postgresql://user:password@localhost:5432/dbname

# Logging
WEB_MONITOR_ENABLED=true
WEB_MONITOR_HOST=127.0.0.1
WEB_MONITOR_PORT=8765
DEBUG=true
MCP_LOG_LEVEL=info
CLOUD_TTS_PROVIDER=elevenlabs
WEB_AUDIO_ENABLED=true
WEB_STT_PROVIDER=openai
WEB_STT_MODEL=whisper-1
WEB_TTS_PROVIDER=elevenlabs
WEB_TTS_MODEL=gpt-4o-mini-tts
STT_PROMPT="⬆️Commandes courtes en français pour commander des dispositif audio visuel sur une scène. Ne colle pas le verbe 'mets' au nom qui suit: écris 'mets Claude', 'mets Voc-Claude', 'mets snare'. "
SESSION_CONTEXT_SIZE=1500
WEB_TTS_VOICE=alloy
WEB_TTS_SPEED=1.00
REMOTE_SCREEN_VNC_URL="vnc://192.168.0.160:5900?password=ronron"
