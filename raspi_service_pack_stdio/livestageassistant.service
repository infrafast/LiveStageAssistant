[Unit]
Description=Live Stage Assistant stdio MCP Agent
Documentation=https://github.com/infrafast/LiveStageAssistant
After=network-online.target tailscaled.service sound.target qlcplus.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/LiveStageAssistant
Environment=ASSISTANT_AUTO_ENV_DIR=/etc/livestageassistant
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/home/pi/LiveStageAssistant/.venv/bin/python voice_assistant/agent.py --env-file auto
Restart=always
RestartSec=5
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
