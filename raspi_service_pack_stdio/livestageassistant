#!/usr/bin/env bash
set -euo pipefail

SERVICE="livestageassistant.service"
ENV_DIR="/etc/livestageassistant"
ONLINE_ENV_FILE="$ENV_DIR/.env.online"
OFFLINE_ENV_FILE="$ENV_DIR/.env.offline"
APP_DIR="/home/pi/LiveStageAssistant"
PYTHON_BIN="$APP_DIR/.venv/bin/python"

read_env_value() {
  local key="$1"
  local value=""
  for env_file in "$ONLINE_ENV_FILE" "$OFFLINE_ENV_FILE"; do
    if [ -f "$env_file" ]; then
      value="$(sed -n "s/^${key}=//p" "$env_file" | tail -n 1 | tr -d '"')"
      if [ -n "$value" ]; then
        echo "$value"
        return
      fi
    fi
  done
}

WEB_PORT="$(read_env_value WEB_MONITOR_PORT)"
WEB_PORT="${WEB_PORT:-8765}"
WEB_URL="http://127.0.0.1:$WEB_PORT"
SNAPSHOT_URL="$WEB_URL/api/snapshot"

cmd="${1:-}"

case "$cmd" in
  start)
    sudo systemctl start "$SERVICE"
    ;;
  stop)
    sudo systemctl stop "$SERVICE"
    ;;
  restart)
    sudo systemctl restart "$SERVICE"
    ;;
  status)
    systemctl status "$SERVICE" --no-pager
    ;;
  logs)
    journalctl -u "$SERVICE" -f
    ;;
  run-auto)
    cd "$APP_DIR"
    ASSISTANT_AUTO_ENV_DIR="$ENV_DIR" "$PYTHON_BIN" -m voice_assistant.runtime --env-file auto
    ;;
  auto)
    sudo systemctl enable "$SERVICE"
    sudo systemctl start "$SERVICE"
    echo "Live Stage Assistant auto-start enabled and service started."
    ;;
  noauto)
    sudo systemctl disable "$SERVICE"
    echo "Live Stage Assistant auto-start disabled."
    ;;
  last-state)
    echo "Enabled: $(systemctl is-enabled "$SERVICE" 2>/dev/null || true)"
    echo "Active : $(systemctl is-active "$SERVICE" 2>/dev/null || true)"
    ;;
  health)
    if curl -fsS "$SNAPSHOT_URL" >/dev/null; then
      echo "Live Stage Assistant web monitor is responding at $WEB_URL"
    else
      echo "Web monitor did not respond at $SNAPSHOT_URL"
      exit 1
    fi
    ;;
  test-remote)
    IP="$(tailscale ip -4 2>/dev/null | head -n 1)"
    if [ -z "$IP" ]; then
      echo "No Tailscale IPv4 found."
      exit 1
    fi
    echo "Local web monitor:  $WEB_URL"
    echo "Remote web monitor: http://$IP:$WEB_PORT"
    curl -I "http://$IP:$WEB_PORT" || true
    ;;
  config)
    echo "Online profile : $ONLINE_ENV_FILE"
    echo "Offline profile: $OFFLINE_ENV_FILE"
    sudo nano "$ONLINE_ENV_FILE" "$OFFLINE_ENV_FILE"
    ;;
  *)
    echo "Usage: livestageassistant {start|stop|restart|status|logs|run-auto|auto|noauto|last-state|health|test-remote|config}"
    exit 1
    ;;
esac
